    {
      "cell_type": "code",
      "source": [
        "# 1. Definición de la señal de entrada\n",
        "\n",
        "# Parámetros de la señal\n",
        "A_m = 1\n",
        "f_m = 5\n",
        "t = np.linspace(0, 1, 1000)\n",
        "\n",
        "# Creamos la señal de información\n",
        "senal_mensaje = A_m * np.sin(2 * np.pi * f_m * t)\n",
        "\n",
        "# Graficamos la señal original\n",
        "plt.figure(figsize=(10, 4))\n",
        "plt.plot(t, senal_mensaje)\n",
        "plt.title(\"Señal de entrada (Mensaje)\")\n",
        "plt.xlabel(\"Tiempo (segundos)\")\n",
        "plt.ylabel(\"Amplitud\")\n",
        "plt.grid()\n",
        "plt.show()"
      ],
      "metadata": {
