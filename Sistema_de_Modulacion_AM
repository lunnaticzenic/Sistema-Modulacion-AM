    {
      "cell_type": "code",
      "source": [
        "\n",
        "# 2. Implementación de la modulación AM\n",
        "\n",
        "# Definimos los parámetros de la portadora\n",
        "A_c = 1\n",
        "f_c = 100\n",
        "m = 0.5\n",
        "\n",
        "# Creamos la señal portadora\n",
        "portadora = A_c * np.cos(2 * np.pi * f_c * t)\n",
        "\n",
        "# Aplicamos la modulación en amplitud\n",
        "senal_AM = A_c * (1 + m * senal_mensaje) * np.cos(2 * np.pi * f_c * t)\n",
        "\n",
        "# Graficamos la señal modulada\n",
        "plt.figure(figsize=(12, 5))\n",
        "plt.plot(t, senal_AM)\n",
        "plt.title(\"Señal modulada en amplitud (AM)\")\n",
        "plt.xlabel(\"Tiempo (segundos)\")\n",
        "plt.ylabel(\"Amplitud\")\n",
        "plt.grid()\n",
        "plt.show()\n"
      ],
