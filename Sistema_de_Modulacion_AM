      "cell_type": "code",
      "source": [
        "\n",
        "# 3. Análisis de la señal en el dominio de la frecuencia\n",
        "\n",
        "# Calculamos la Transformada Rápida de Fourier (FFT)\n",
        "N = len(senal_AM)\n",
        "frecuencias = fftfreq(N, t[1] - t[0])\n",
        "espectro = np.abs(fft(senal_AM)) / N\n",
        "\n",
        "# Graficamos el espectro de frecuencia\n",
        "plt.figure(figsize=(12, 5))\n",
        "plt.plot(frecuencias[:N//2], espectro[:N//2])\n",
        "plt.title(\"Espectro de frecuencia de la señal AM\")\n",
        "plt.xlabel(\"Frecuencia (Hz)\")\n",
        "plt.ylabel(\"Amplitud\")\n",
        "plt.grid()\n",
        "plt.show()\n"
      ],
